{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:ApiError:1.0",
  "title": "ApiError",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "retryable": {
          "type": "boolean"
        },
        "field_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "code",
        "message",
        "request_id",
        "retryable",
        "field_errors"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
