{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:UploadInit:1.0",
  "title": "UploadInit",
  "type": "object",
  "properties": {
    "filename": {
      "type": "string",
      "minLength": 1
    },
    "content_type": {
      "type": "string",
      "minLength": 1
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 26214400
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "filename",
    "content_type",
    "bytes",
    "sha256"
  ],
  "additionalProperties": false
}
