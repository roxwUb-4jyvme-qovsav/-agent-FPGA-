{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:Answer:1.0",
  "title": "Answer",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision_id": {
      "type": "string",
      "format": "uuid"
    },
    "value": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "question_id",
    "revision_id",
    "value",
    "unit"
  ],
  "additionalProperties": false
}
