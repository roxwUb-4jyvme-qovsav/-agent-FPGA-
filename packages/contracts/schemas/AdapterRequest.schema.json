{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:AdapterRequest:1.0",
  "title": "AdapterRequest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "invocation_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision_id": {
      "type": "string",
      "format": "uuid"
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "input_schema": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "approval_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "invocation_id",
    "project_id",
    "revision_id",
    "capability",
    "operation",
    "input_schema",
    "input",
    "deadline",
    "approval_ids",
    "idempotency_key"
  ],
  "additionalProperties": false
}
