{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:ArtifactRef:1.0",
  "title": "ArtifactRef",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "sha256",
    "kind"
  ],
  "additionalProperties": false
}
