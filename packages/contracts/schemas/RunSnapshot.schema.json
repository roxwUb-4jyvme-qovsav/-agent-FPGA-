{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:RunSnapshot:1.0",
  "title": "RunSnapshot",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision_id": {
      "type": "string",
      "format": "uuid"
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "$ref": "urn:fpga:contracts:ArtifactRef:1.0"
      }
    },
    "model_profile_version_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "skill_version_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "extension_version_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "acceptance_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolchain_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generator_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "price_version_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "max_cost_cny": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "project_id",
    "revision_id",
    "input_artifacts",
    "model_profile_version_ids",
    "skill_version_ids",
    "extension_version_ids",
    "acceptance_sha256",
    "toolchain_sha256",
    "generator_sha256",
    "price_version_id",
    "deadline",
    "max_cost_cny",
    "created_at"
  ],
  "additionalProperties": false
}
