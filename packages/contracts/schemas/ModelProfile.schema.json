{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:ModelProfile:1.0",
  "title": "ModelProfile",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "provider_kind": {
      "type": "string",
      "enum": [
        "deepseek",
        "dashscope",
        "openai_compatible",
        "mock"
      ]
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_origin": {
      "type": "string",
      "enum": [
        "CN",
        "test_only"
      ]
    },
    "secret_ref": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "text",
          "vision",
          "tools",
          "json",
          "embedding",
          "rerank"
        ]
      },
      "uniqueItems": true
    },
    "context_limit": {
      "type": "integer",
      "minimum": 1
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "price_input_per_million_cny": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "price_output_per_million_cny": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "daily_budget_cny": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"
    },
    "fallback_profile_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "id",
    "display_name",
    "provider_kind",
    "base_url",
    "model_id",
    "runtime_origin",
    "secret_ref",
    "capabilities",
    "context_limit",
    "max_output_tokens",
    "timeout_seconds",
    "price_input_per_million_cny",
    "price_output_per_million_cny",
    "daily_budget_cny",
    "fallback_profile_ids",
    "enabled"
  ],
  "additionalProperties": false
}
