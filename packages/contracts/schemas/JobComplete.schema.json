{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:JobComplete:1.0",
  "title": "JobComplete",
  "type": "object",
  "properties": {
    "worker_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "result": {
      "oneOf": [
        {
          "$ref": "urn:fpga:contracts:ToolResult:1.0"
        },
        {
          "$ref": "urn:fpga:contracts:AgentResult:1.0"
        }
      ]
    }
  },
  "required": [
    "worker_id",
    "attempt",
    "fencing_token",
    "result"
  ],
  "additionalProperties": false
}
