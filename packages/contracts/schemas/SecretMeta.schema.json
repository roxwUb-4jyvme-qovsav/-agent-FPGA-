{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:SecretMeta:1.0",
  "title": "SecretMeta",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "rotated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "configured": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "label",
    "created_at",
    "rotated_at",
    "configured"
  ],
  "additionalProperties": false
}
