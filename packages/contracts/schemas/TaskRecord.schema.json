{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:TaskRecord:1.0",
  "title": "TaskRecord",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "QUEUED",
        "LEASED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "WAITING_INPUT",
        "CANCEL_REQUESTED",
        "CANCELLED",
        "LOST"
      ]
    },
    "envelope": {
      "$ref": "urn:fpga:contracts:TaskEnvelope:1.0"
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "urn:fpga:contracts:TaskQuestion:1.0"
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "urn:fpga:contracts:TaskAttempt:1.0"
      }
    },
    "waiting_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "anyOf": [
        {
          "oneOf": [
            {
              "$ref": "urn:fpga:contracts:AgentResult:1.0"
            },
            {
              "$ref": "urn:fpga:contracts:ToolResult:1.0"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "task_id",
    "run_id",
    "version",
    "state",
    "envelope",
    "questions",
    "attempts",
    "waiting_reason",
    "result"
  ],
  "additionalProperties": false
}
