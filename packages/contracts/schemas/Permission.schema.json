{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:Permission:1.0",
  "title": "Permission",
  "type": "object",
  "properties": {
    "capability": {
      "type": "string",
      "enum": [
        "read_artifact",
        "write_candidate",
        "network",
        "git_write",
        "cad_write",
        "spawn_tool",
        "read_knowledge",
        "render_panel"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "approval_required": {
      "type": "boolean"
    }
  },
  "required": [
    "capability",
    "scope",
    "approval_required"
  ],
  "additionalProperties": false
}
