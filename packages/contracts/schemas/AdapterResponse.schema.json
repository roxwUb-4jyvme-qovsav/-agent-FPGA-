{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:AdapterResponse:1.0",
  "title": "AdapterResponse",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "invocation_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "timeout",
        "denied"
      ]
    },
    "output_schema": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "invocation_id",
    "status",
    "output_schema",
    "output",
    "diagnostics",
    "request_id"
  ],
  "additionalProperties": false
}
