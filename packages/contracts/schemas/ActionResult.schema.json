{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:ActionResult:1.0",
  "title": "ActionResult",
  "type": "object",
  "properties": {
    "resource_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_cursor": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "resource_id",
    "state",
    "run_id",
    "approval_id",
    "event_cursor"
  ],
  "additionalProperties": false
}
