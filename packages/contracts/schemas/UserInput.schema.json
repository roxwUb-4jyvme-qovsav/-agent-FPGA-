{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:UserInput:1.0",
  "title": "UserInput",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "minLength": 1
    },
    "global_role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ]
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "username",
    "global_role",
    "enabled"
  ],
  "additionalProperties": false
}
