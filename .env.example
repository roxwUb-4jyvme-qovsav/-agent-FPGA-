# 复制为 .env，并使用 scripts/setup.ps1 自动生成本机凭据。不要提交 .env。
FPGA_DATABASE_URL=postgresql+psycopg://fpga:CHANGE_ME@127.0.0.1:5432/fpga_platform
POSTGRES_PASSWORD=CHANGE_ME
FPGA_DATA_DIR=.local/data
FPGA_ALLOW_SQLITE=0
FPGA_WORKER_TOKEN=
FPGA_VERIFIER_TOKEN=
FPGA_SECRET_KEY=
# FPGA_VERIFIER_KEYS 为受信任公钥注册文件路径，不包含私钥。
# 所有真实模型预算保持 0，须在管理页登记授权与价格后才能调用。
