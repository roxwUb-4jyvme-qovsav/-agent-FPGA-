{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:Collection:1.0",
  "title": "Collection",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "embedding_profile_version_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "embedding_dimension": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "acl_member_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "external_connection_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "name",
    "description",
    "embedding_profile_version_id",
    "embedding_dimension",
    "acl_member_ids",
    "external_connection_id"
  ],
  "additionalProperties": false
}
