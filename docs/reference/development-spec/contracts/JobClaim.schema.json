{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:JobClaim:1.0",
  "title": "JobClaim",
  "type": "object",
  "properties": {
    "worker_id": {
      "type": "string",
      "format": "uuid"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tool_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "worker_id",
    "capabilities",
    "tool_profile_sha256"
  ],
  "additionalProperties": false
}
