{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:VerificationEvidence:1.0",
  "title": "VerificationEvidence",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "test_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "suite_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "status": {
      "type": "string",
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "INDETERMINATE"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "rtl_simulation",
        "hardware",
        "replay",
        "mock",
        "static"
      ]
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "report": {
      "$ref": "urn:fpga:contracts:ArtifactRef:1.0"
    },
    "issuer_id": {
      "type": "string",
      "format": "uuid"
    },
    "auth_tag": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      },
      "required": [
        "algorithm",
        "key_id",
        "signature"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "project_id",
    "revision_id",
    "task_id",
    "test_id",
    "input_sha256",
    "suite_sha256",
    "environment_sha256",
    "tool_version",
    "template_id",
    "seed",
    "status",
    "mode",
    "exit_code",
    "started_at",
    "finished_at",
    "report",
    "issuer_id",
    "auth_tag"
  ],
  "additionalProperties": false
}
