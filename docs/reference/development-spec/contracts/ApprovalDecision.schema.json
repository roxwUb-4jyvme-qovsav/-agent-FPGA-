{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:ApprovalDecision:1.0",
  "title": "ApprovalDecision",
  "type": "object",
  "properties": {
    "expected_version": {
      "type": "integer",
      "minimum": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "reject"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "expected_version",
    "decision",
    "reason"
  ],
  "additionalProperties": false
}
