{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:Session:1.0",
  "title": "Session",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "global_role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ]
    },
    "project_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "developer",
              "reviewer",
              "viewer"
            ]
          }
        },
        "required": [
          "project_id",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "csrf_token": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "user_id",
    "global_role",
    "project_roles",
    "csrf_token"
  ],
  "additionalProperties": false
}
