{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fpga:contracts:PluginManifest:1.0",
  "title": "PluginManifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "mcp",
        "knowledge",
        "model",
        "quote",
        "skill",
        "ui",
        "bundle"
      ]
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "engine_api": {
      "const": "1.0"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "transport": {
      "type": "string",
      "enum": [
        "stdio",
        "streamable_http",
        "https_json",
        "static",
        "skill"
      ]
    },
    "config_schema_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$"
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "urn:fpga:contracts:Permission:1.0"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "payload_sha256"
        ],
        "additionalProperties": false
      }
    },
    "healthcheck": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      },
      "required": [
        "method",
        "timeout_seconds"
      ],
      "additionalProperties": false
    },
    "data_policy": {
      "type": "object",
      "properties": {
        "retention_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3650
        },
        "export_allowed": {
          "type": "boolean"
        },
        "external_send": {
          "type": "boolean"
        }
      },
      "required": [
        "retention_days",
        "export_allowed",
        "external_send"
      ],
      "additionalProperties": false
    },
    "migration_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_version": {
            "type": "string",
            "minLength": 1
          },
          "to_version": {
            "type": "string",
            "minLength": 1
          },
          "script_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\]).+$"
          },
          "reversible": {
            "type": "boolean"
          }
        },
        "required": [
          "from_version",
          "to_version",
          "script_path",
          "reversible"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "kind",
    "publisher",
    "license",
    "source_ref",
    "payload_sha256",
    "signature",
    "engine_api",
    "entrypoint",
    "transport",
    "config_schema_path",
    "permissions",
    "dependencies",
    "healthcheck",
    "data_policy",
    "migration_steps"
  ],
  "additionalProperties": false
}
